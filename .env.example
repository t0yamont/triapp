# IronFlow — environment variables.
# Copy to `.env.local` (gitignored) and fill in from Supabase → Project Settings → API.
# NEVER commit real values. The service-role key is SERVER-ONLY (CLAUDE.md §4; ARCH §6):
# it must never appear in client code or in any NEXT_PUBLIC_* variable.

# ── Public — safe to expose to the browser ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# ── Server-only — never sent to the client ──────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ── CLI / CI only (optional) — for `supabase db push` from automation ────────
# Prefer running `supabase login` interactively on your own machine instead of
# storing these. If you must automate, set them as CI secrets, not in this file.
# SUPABASE_ACCESS_TOKEN=<personal access token>
# SUPABASE_DB_PASSWORD=<database password>

# ── OAuth provider secrets (Phase 1: Google, Apple) — server-only ────────────
# SUPABASE_AUTH_GOOGLE_SECRET=
# SUPABASE_AUTH_APPLE_SECRET=
