{
  "name": "ironflow",
  "version": "0.0.0",
  "private": true,
  "description": "IronFlow — adaptive multi-sport endurance training platform. The physiology engine is the product.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:physio": "pnpm --filter @ironflow/core test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
